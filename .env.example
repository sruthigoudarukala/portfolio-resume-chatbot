# Copy this file to .env and replace the placeholders with your own keys.
# NEVER commit the real .env file (it is listed in .gitignore).
NVIDIA_API_KEY=nvapi-xxxxxxxx
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_xxxxxxxx
LANGSMITH_PROJECT=technova-bot-sruthi

# Optional: choose the models (these are the defaults)
# SMALL_MODEL=openai/gpt-oss-20b
# LARGE_MODEL=nvidia/nemotron-3-super-120b-a12b

# Optional: failure to trigger on purpose (none, bad_model, bad_key, timeout, tool_failure, bad_input)
FAULT_MODE=none
